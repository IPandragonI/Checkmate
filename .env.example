### App ###
NEXT_PUBLIC_BASE_URL=http://localhost:3000

### Better Auth ###
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

### Database (PostgreSQL) ###
# Runtime connection. On Vercel use a POOLED connection string (Neon / Supabase pooler / PgBouncer).
DATABASE_URL=postgresql://user:password@localhost:5432/checkmate
# Direct (non-pooled) connection, used only by `prisma migrate`.
DIRECT_URL=postgresql://user:password@localhost:5432/checkmate
# docker-compose (local dev only)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

### Pusher Channels (real-time) - https://dashboard.pusher.com ###
PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

### Email (Resend) - verification + contact form ###
SMTP_FROM=
SMTP_TO=
# Resend API key
SMTP_PASS=
